# Copia este archivo como .env en core-transaccional/ y ajusta los valores.
# spring-dotenv lo carga automaticamente al ejecutar ./gradlew bootRun

# Servidor
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/core_transaccional_db
DB_USERNAME=postgres
DB_PASSWORD=cambiar_password

# JPA (desarrollo)
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Redis (Upstash / ElastiCache / local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_SSL_ENABLED=false
REDIS_CHANNEL_BOLETOS_EMITIR=boletos.emitir

# Motor IA (CU-09, CU-10, CU-11)
MOTOR_IA_BASE_URL=http://localhost:8080
MOTOR_IA_TIMEOUT_SECONDS=15

# JWT (minimo 32 caracteres para HS256)
JWT_SECRET=cambiar-por-un-secreto-seguro-minimo-32-chars
JWT_EXPIRATION_MS=86400000

# DynamoDB (navegacion: clicks y feedback)
AWS_DYNAMODB_ENABLED=true
AWS_DYNAMODB_REGION=us-east-2
AWS_DYNAMODB_CLICKS_TABLE_NAME=ClicksViajero
AWS_DYNAMODB_FEEDBACK_TABLE_NAME=FeedbackViajero
# AWS_DYNAMODB_ENDPOINT=http://localhost:8000

# Seeders demo (opcional)
DEMO_CU09_NICOLAS_RESERVATIONS=28
DEMO_CU09_KLAUS_RESERVATIONS=10
DEMO_CU09_SEBASTIAN_RESERVATIONS=16
