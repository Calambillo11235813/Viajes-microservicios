type Query {
    buscarRutasYHorariosDisponibles(
        origen: String!
        destino: String!
        fecha: String!
        idUsuario: Int
        pagina: Int
        tamanio: Int
    ): PaginaViajes!

    obtenerMapaAsientos(idViaje: Int!): [AsientoEstado!]!

    obtenerPerfilUsuario(idUsuario: Int!): UsuarioPerfil!

    consultarHistorialViajes(idUsuario: Int!, pagina: Int, tamanio: Int): PaginaHistorial!

    listarUsuarios: [UsuarioPerfil!]!
    
    listarRoles: [Rol!]!

    listarRutas(pagina: Int, tamanio: Int): PaginaRutas!

    listarViajesPorRuta(idRuta: Int!, pagina: Int, tamanio: Int): PaginaViajes!

    generarReporteVentas(
        fechaInicio: String!
        fechaFin: String!
    ): ReporteVentas!

    listarFlotas: [Flota!]!

    buscarViajesPorDestinoTuristico(
        nombreDestino: String!
        page: Int = 0
        size: Int = 10
        fecha: String
        origen: String
    ): DestinoViajesResponse!

    listarOrigenesHaciaDestinoTuristico(nombreDestino: String!): OrigenesDestinoTuristicoResponse!

    obtenerRecomendacionRuta(idUsuario: Int!, presupuesto: Float): RecomendacionRutaResponse!

    buscarDestinosPorImagen(urlImagen: String!): [DestinoRecomendado!]!
    generarReelTuristico(idRuta: Int!): ReelTuristico!
}

type Mutation {
    login(email: String!, passwordHash: String!): AuthResponse!

    seleccionarAsientoYReservar(
        idUsuario: Int!
        idViaje: Int!
        numeroAsiento: String!
        nombrePasajero: String!
        tipoPasajero: String
    ): ReservaProvisional!

    realizarPago(
        idReserva: Int!
        metodoPagoUsado: String!
        montoTransaccion: Float!
        acreditado: Boolean!
        cuponDescuentoAplicado: String
    ): PagoConfirmado!

    actualizarPerfilUsuario(
        idUsuario: Int!
        nombreCompleto: String
        email: String
        telefono: String
        ciPasaporte: String
    ): UsuarioPerfil!

    cancelarReserva(
        idReserva: Int!
        idUsuario: Int!
    ): ReservaCancelada!

    crearUsuario(
        ciPasaporte: String!
        nombreCompleto: String!
        email: String!
        passwordHash: String!
        telefono: String
        idRol: Int!
    ): UsuarioPerfil!
    
    actualizarUsuario(
        idUsuario: Int!
        nombreCompleto: String
        email: String
        telefono: String
        idRol: Int
    ): UsuarioPerfil!
    
    eliminarUsuario(idUsuario: Int!): Boolean!

    crearRuta(
        origen: String!
        destino: String!
        duracion: Float!
        precio: Float!
        categoria: String
    ): RutaDestino!

    actualizarRuta(
        idRuta: Int!
        origen: String
        destino: String
        duracion: Float
        precio: Float
        categoria: String
    ): RutaDestino!

    eliminarRuta(idRuta: Int!): Boolean!

    programarViaje(
        idRuta: Int!
        idBus: Int!
        fechaHoraSalida: String!
    ): ViajeDisponible!

    actualizarViajeProgramado(
        idViaje: Int!
        idBus: Int
        fechaHoraSalida: String
    ): ViajeDisponible!

    cancelarViajeProgramado(idViaje: Int!): Boolean!

    crearFlota(
        placa: String!
        capacidadTotalAsientos: Int!
        tipoBus: String!
    ): Flota!

    actualizarFlota(
        idBus: Int!
        placa: String
        capacidadTotalAsientos: Int
        tipoBus: String
    ): Flota!

    eliminarFlota(idBus: Int!): Boolean!

    registrarVisualizacionRuta(
        idUsuario: Int!
        idRuta: Int
        origen: String
        destino: String
        canal: String
        categoriaVista: String
        ciudadOrigenVista: String
        ciudadDestinoVista: String
        idRutaVista: Int
        tiempoPermanenciaSeg: Int
        dispositivo: String
    ): Boolean!
}

type PaginaViajes {
    contenido: [ViajeDisponible!]!
    totalPaginas: Int!
    totalElementos: Int!
    paginaActual: Int!
    tieneSiguiente: Boolean!
}

type PaginaHistorial {
    contenido: [HistorialViaje!]!
    totalPaginas: Int!
    totalElementos: Int!
    paginaActual: Int!
    tieneSiguiente: Boolean!
}

type PaginaRutas {
    contenido: [RutaDestino!]!
    totalPaginas: Int!
    totalElementos: Int!
    paginaActual: Int!
    tieneSiguiente: Boolean!
}

type ViajeDisponible {
    idViaje: ID!
    idRuta: ID!
    ciudadOrigen: String!
    ciudadDestino: String!
    fechaHoraSalida: String!
    fechaHoraLlegada: String!
    duracionEstimadaHoras: Float!
    precioBase: Float!
    categoriaTuristica: String
    idBus: ID!
    tipoBus: String!
    capacidadTotalAsientos: Int!
    estadoViaje: String!
}

type AsientoEstado {
    numeroAsiento: String!
    ocupado: Boolean!
}

type ReservaProvisional {
    idReserva: ID!
    idBoleto: ID!
    idViaje: ID!
    idUsuario: ID!
    numeroAsiento: String!
    nombrePasajero: String!
    tipoPasajero: String!
    estadoReserva: String!
    estadoBoleto: String!
    montoEstimado: Float!
    fechaCreacion: String!
}

type PagoConfirmado {
    idPago: ID!
    idReserva: ID!
    idUsuario: ID!
    idViaje: ID!
    montoTransaccion: Float!
    metodoPagoUsado: String!
    estadoPago: String!
    estadoReserva: String!
    fechaPago: String!
    eventoEmitido: Boolean!
}

type UsuarioPerfil {
    idUsuario: ID!
    ciPasaporte: String!
    nombreCompleto: String!
    email: String!
    telefono: String
    idRol: Int!
}

type ReservaCancelada {
    idReserva: ID!
    idUsuario: ID!
    idViaje: ID!
    ciudadOrigen: String!
    ciudadDestino: String!
    estadoReserva: String!
    estadoPago: String!
    boletosAnulados: Int!
    montoReembolsado: Float!
    fechaCancelacion: String!
}

type HistorialViaje {
    idReserva: ID!
    idViaje: ID!
    ciudadOrigen: String!
    ciudadDestino: String!
    fechaHoraSalida: String!
    fechaCreacion: String!
    estadoReserva: String!
    montoTotalPagado: Float!
    cantidadPasajeros: Int!
}

type Rol {
    id: ID!
    nombre: String!
}

type RutaDestino {
    id: ID!
    ciudadOrigen: String!
    ciudadDestino: String!
    duracionEstimadaHoras: Float!
    precioBase: Float!
    categoriaTuristica: String
}

type ReporteVentas {
    montoTotal: Float!
    cantidadPagos: Int!
    ocupacionFlota: Float!
    fechaInicio: String!
    fechaFin: String!
    detallesPorFecha: [VentasPorFecha!]!
}

type VentasPorFecha {
    fecha: String!
    montoDia: Float!
    cantidadPagosDia: Int!
}

type AuthResponse {
    token: String!
    usuario: UsuarioPerfil!
}

type Flota {
    idBus: ID!
    placa: String!
    capacidadTotalAsientos: Int!
    tipoBus: String!
}

type DestinoTuristicoInfo {
    id: ID!
    nombreTuristico: String!
    departamento: String!
    descripcion: String
}

type DestinoViajesResponse {
    destino: DestinoTuristicoInfo!
    viajesDisponibles: [ViajeDisponible!]!
}

type OrigenesDestinoTuristicoResponse {
    departamento: String!
    origenes: [String!]!
}

type RecomendacionRutaResponse {
    rutaRecomendadaId: Int
    perfilUsuario: String
    categoriaPreferida: String
    topRutas: [TopRuta!]
    advertencia: String
}

type TopRuta {
    idRuta: Int
    probabilidad: Float
}

type DestinoRecomendado {
    ciudad: String!
    porcentajeCoincidencia: Float!
    descripcion: String!
}

type ReelTuristico {
    urlVideo: String!
    duracionSegundos: Int!
}
