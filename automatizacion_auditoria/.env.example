# Redis / Asynq (local)
REDIS_ADDR=localhost:6379

# Redis / Asynq (Upstash: TLS + auth obligatorios)
# REDIS_ADDR=tu-instancia.upstash.io:6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=tu-token-upstash
# REDIS_USE_TLS=true

# Webhook n8n → Telegram
N8N_TELEGRAM_WEBHOOK_URL=https://tu-n8n.com/webhook/telegram-boleto

# Amazon S3 (region: AWS_REGION, AWS_S3_REGION_NAME o S3_REGION)
AWS_REGION=us-east-1
# S3_REGION=us-east-2
S3_BUCKET_NAME=tu-bucket-boletos
# AWS_STORAGE_BUCKET_NAME=tu-bucket-boletos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

